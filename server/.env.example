# Copier en .env (jamais commité) ou renseigner ces variables chez l'hébergeur.

# Port d'écoute (la plupart des hébergeurs l'imposent).
PORT=8080

# Où sont rangés les droits. Sur un hébergeur sans disque persistant,
# monter un volume ou remplacer src/store.js par une vraie base.
DATA_FILE=./data/entitlements.json

# Secret partagé avec RevenueCat : à recopier à l'identique dans
# RevenueCat → Project settings → Integrations → Webhooks → Authorization
# header. Le serveur refuse tout appel qui ne le présente pas.
REVENUECAT_WEBHOOK_SECRET=

# Nom du package de l'app (définitif, identique à app.json).
GOOGLE_PLAY_PACKAGE_NAME=com.flirtgame.app

# Compte de service Google Play, en JSON sur une seule ligne. Sert à
# vérifier un achat directement auprès de Google. Facultatif : inutile si
# la vérification est déléguée à RevenueCat.
GOOGLE_SERVICE_ACCOUNT_JSON=
